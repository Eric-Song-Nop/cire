{
  // Cire 项目配置文件示例 - 复制此文件为 .cire.json5 并根据项目需求修改
  // JSON5 格式支持注释、尾随逗号等更友好的语法

  name: "My Cire Project",
  version: "1.0.0",
  description: "Static website generated with Cire - providing IDE-like experiences for documentation",

  // 源代码输入配置
  input: {
    root: "./src",                    // 源代码根目录

    // 包含的文件模式（支持 glob 语法）
    include: [
      "**/*.ts",                      // TypeScript 文件
      "**/*.js",                      // JavaScript 文件
      "**/*.tsx",                     // TypeScript React 文件
      "**/*.jsx",                     // JavaScript React 文件
    ],

    // 排除的文件模式
    exclude: [
      "**/*.test.ts",                 // 测试文件
      "**/*.spec.ts",
      "**/*.test.js",
      "**/*.spec.js",
      "**/*.d.ts",                    // TypeScript 声明文件
      "node_modules/**",              // 依赖目录
      "dist/**",                      // 构建输出目录
      "build/**",
      ".git/**",                      // Git 目录
      "**/*.min.js",                  // 压缩文件
    ],

    language: "typescript",           // 源代码语言
    // 支持的语言: typescript, javascript, python, go, rust, java, c, cpp 等
  },

  // 输出配置
  output: {
    directory: "./dist",              // 输出目录
    baseUrl: "/",                     // 部署时的基础路径，如: /docs/ 或 /project-name/
  },

  // 语言服务器协议配置（可选，用于 hover 文档和代码智能）
  lsp: {
    indexPath: "./index.scip",        // SCIP 索引文件路径，使用 scip-typescript 生成
    provider: "scip",                 // LSP 提供者
    // 支持的提供者: scip, 未来可能支持 tsserver, pylsp 等
  },

  // 模板配置（可选）
  template: {
    layout: "default",                // 布局模板: "default" | "minimal"
    theme: "light",                   // 主题: "light" | "dark" | "auto"
    // customCSS: "./custom.css",      // 自定义 CSS 文件路径（可选）
  },

  // 功能开关（可选）
  features: {
    syntaxHighlighting: true,         // 启用语法高亮
    hoverDocumentation: true,         // 启用 hover 文档显示
    definitionJumping: true,          // 启用点击跳转到定义
    commentMarkdown: true,            // 启用注释转 Markdown 功能
    navigationIndex: false,           // 启用导航索引页面
  },
}