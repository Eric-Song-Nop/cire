{
	"name": "@cire-doc/cire-cli",
	"version": "0.1.0",
	"description": "Static website generator providing IDE-like experiences for documentation",
	"main": "dist/cli.js",
	"bin": {
		"cire": "dist/cli.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/cli.js",
		"build:docs": "pnpm build && npx @sourcegraph/scip-typescript index && pnpm start -c .cire.json5",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check",
		"format": "biome format --write",
		"lint:fix": "biome check --write",
		"clean": "rm -rf dist output",
		"prepublishOnly": "pnpm run build && pnpm run test && pnpm run lint",
		"prepack": "pnpm run build",
		"release": "pnpm run clean && pnpm run build && pnpm run test && pnpm publish --no-git-checks",
		"release:dry": "pnpm pack --dry-run",
		"version:patch": "pnpm version patch",
		"version:minor": "pnpm version minor",
		"version:major": "pnpm version major"
	},
	"keywords": [
		"static-site-generator",
		"documentation",
		"typescript",
		"tree-sitter",
		"lsif",
		"scip",
		"ide",
		"syntax-highlighting"
	],
	"author": {
		"name": "Yifan Song",
		"email": "ericoolen@yeah.net",
		"url": "https://cire.netlify.app"
	},
	"homepage": "https://github.com/Eric-Song-Nop/cire",
	"repository": {
		"type": "git",
		"url": "https://github.com/Eric-Song-Nop/cire.git"
	},
	"bugs": {
		"url": "https://github.com/Eric-Song-Nop/cire/issues"
	},
	"license": "MIT",
	"dependencies": {
		"@sourcegraph/scip": "github:sourcegraph/scip",
		"@sourcegraph/scip-typescript": "^0.4.0",
		"@types/handlebars": "^4.1.0",
		"chalk": "^5.3.0",
		"commander": "^14.0.2",
		"comment-parser": "^1.4.1",
		"glob": "^10.3.10",
		"google-protobuf": "^3.20.1",
		"handlebars": "^4.7.8",
		"json5": "^2.2.3",
		"loglevel": "^1.9.2",
		"markdown-it": "^14.1.0",
		"marked": "^9.1.6",
		"tree-sitter": "^0.25.0",
		"tree-sitter-typescript": "^0.23.2",
		"ts-pattern": "^5.9.0"
	},
	"devDependencies": {
		"@antfu/ni": "^0.21.8",
		"@biomejs/biome": "2.2.7",
		"@commander-js/extra-typings": "^14.0.0",
		"@types/google-protobuf": "^3.15.12",
		"@types/json5": "^2.2.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^20.9.0",
		"@vitest/coverage-v8": "^4.0.3",
		"@vitest/ui": "^4.0.3",
		"jsdom": "^27.0.1",
		"typescript": "^5.2.2",
		"vitest": "^4.0.3"
	},
	"files": [
		"dist/",
		"templates/",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=10.0.0"
	}
}
