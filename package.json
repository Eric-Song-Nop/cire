{
	"name": "cire",
	"version": "0.1.0",
	"description": "Static website generator providing IDE-like experiences for documentation",
	"main": "dist/index.js",
	"bin": {
		"cire": "dist/cli.js"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/cli.js",
		"test": "jest",
		"lint": "biome check",
		"format": "biome format --fix"
	},
	"keywords": [
		"static-site-generator",
		"documentation",
		"typescript",
		"tree-sitter",
		"lsif",
		"scip",
		"ide",
		"syntax-highlighting"
	],
	"author": "Cire Team",
	"license": "MIT",
	"dependencies": {
		"@sourcegraph/scip": "github:sourcegraph/scip",
		"@sourcegraph/scip-typescript": "^0.4.0",
		"chalk": "^5.3.0",
		"commander": "^11.1.0",
		"glob": "^10.3.10",
		"marked": "^9.1.6",
		"tree-sitter": "^0.25.0",
		"tree-sitter-typescript": "^0.23.2"
	},
	"devDependencies": {
		"@antfu/ni": "^0.21.8",
		"@biomejs/biome": "2.2.7",
		"@types/google-protobuf": "^3.15.12",
		"@types/jest": "^29.5.8",
		"@types/node": "^20.9.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.1",
		"typescript": "^5.2.2"
	},
	"engines": {
		"node": "22.21.0",
		"pnpm": ">=10.0.0"
	}
}
