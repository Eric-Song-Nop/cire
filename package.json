{
	"name": "cire",
	"version": "0.1.0",
	"description": "Static website generator providing IDE-like experiences for documentation",
	"main": "dist/cli.js",
	"bin": {
		"cire": "dist/cli.js"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/cli.js",
		"build:docs": "pnpm build && npx @sourcegraph/scip-typescript index && pnpm start -c .cire.json5",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check",
		"format": "biome format --write",
		"lint:fix": "biome check --write",
		"clean": "rm -rf dist output"
	},
	"keywords": [
		"static-site-generator",
		"documentation",
		"typescript",
		"tree-sitter",
		"lsif",
		"scip",
		"ide",
		"syntax-highlighting"
	],
	"author": "Cire Team",
	"license": "MIT",
	"dependencies": {
		"@sourcegraph/scip": "github:sourcegraph/scip",
		"@sourcegraph/scip-typescript": "^0.4.0",
		"chalk": "^5.3.0",
		"commander": "^11.1.0",
		"comment-parser": "^1.4.1",
		"glob": "^10.3.10",
		"google-protobuf": "^3.20.1",
		"json5": "^2.2.3",
		"loglevel": "^1.9.2",
		"marked": "^9.1.6",
		"tree-sitter": "^0.25.0",
		"tree-sitter-typescript": "^0.23.2",
		"ts-pattern": "^5.9.0"
	},
	"devDependencies": {
		"@antfu/ni": "^0.21.8",
		"@biomejs/biome": "2.2.7",
		"@types/google-protobuf": "^3.15.12",
		"@types/json5": "^2.2.0",
		"@types/node": "^20.9.0",
		"@vitest/coverage-v8": "^4.0.3",
		"@vitest/ui": "^4.0.3",
		"jsdom": "^27.0.1",
		"typescript": "^5.2.2",
		"vitest": "^4.0.3"
	},
	"engines": {
		"node": "22.21.0",
		"pnpm": ">=10.0.0"
	}
}
